.kpi .n{font-size:11px;color:var(--sub);margin-top:4px}
.kpi.gold .v{background:linear-gradient(180deg,#fff2cf,var(--gold));-webkit-background-clip:text;background-clip:text}
.kpi.rose .v{background:linear-gradient(180deg,#ffd7e4,var(--rose));-webkit-background-clip:text;background-clip:text}
.kpi.cyan .v{background:linear-gradient(180deg,#d5f4ff,var(--cyan));-webkit-background-clip:text;background-clip:text}
