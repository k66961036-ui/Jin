/* ---------- KPI ---------- */
const totalMall = DATA.length;
const totalScreen = DATA.reduce((s,r)=>s+(Number(r.cnt)||0),0);
const provSet = new Set(DATA.map(r=>r.prov).filter(Boolean));
const citySet = new Set(DATA.map(r=>r.city).filter(Boolean));
const multi = DATA.filter(r=>(Number(r.cnt)||0)>1).length;
const kpis=[
  {k:'商场总数',v:totalMall,n:'覆盖 '+'各省市自治区',c:''},
  {k:'大屏总数量',v:totalScreen,n:'平均 '+(totalScreen/totalMall).toFixed(1)+' 块/商场',c:'gold'},
  {k:'覆盖省份',v:provSet.size,n:'省级行政区',c:'rose'},
  {k:'覆盖城市',v:citySet.size,n:'地级市及以上',c:'cyan'},
  {k:'多屏商场',v:multi,n:'屏数 > 1 的商场',c:'rose'},
];
document.getElementById('kpis').innerHTML = kpis.map(o=>
  `<div class="kpi ${o.c}"><div class="k">${o.k}</div><div class="v">${o.v}</div><div class="n">${o.n}</div></div>`
).join('');

/* ---------- 聚合 ---------- */
const byProv={}, byProvScreen={}, byCity={}, byMall=[], byDate={};
DATA.forEach(r=>{
  const c=Number(r.cnt)||0;
  if(r.prov){ byProv[r.prov]=(byProv[r.prov]||0)+1; byProvScreen[r.prov]=(byProvScreen[r.prov]||0)+c; }
  if(r.city){ byCity[r.city]=(byCity[r.city]||0)+1; }
  byMall.push({name:r.mall,city:r.city,prov:r.prov,cnt:c});
  const d=r.date||'未标注';
  let key = /12\.4/.test(d) ? '12.4' : (/11\.2[5789]/.test(d) ? '11.28' : (d==='未标注'?'未标注':'待定'));
  byDate[key]=(byDate[key]||0)+1;
});
const arrProv=Object.entries(byProv).sort((a,b)=>a[1]-b[1]).slice(-18);
const arrProvS=Object.entries(byProvScreen).sort((a,b)=>a[1]-b[1]).slice(-15);
const arrCity=Object.entries(byCity).sort((a,b)=>b[1]-a[1]).slice(0,12);
const arrMall=byMall.sort((a,b)=>b.cnt-a.cnt).slice(0,12).reverse();

const AX={axisLine:{lineStyle:{color:'rgba(120,160,255,.25)'}},axisLabel:{color:'#8fa3cc',fontSize:11},
  splitLine:{lineStyle:{color:'rgba(120,160,255,.09)'}}};
const TIP={backgroundColor:'rgba(12,18,38,.94)',borderColor:'rgba(120,160,255,.35)',
  textStyle:{color:'#e8eeff',fontSize:12}};

function bar(el,labels,vals,color,unit){
  const ch=echarts.init(document.getElementById(el));
  ch.setOption({
    grid:{left:6,right:34,top:8,bottom:4,containLabel:true},
    tooltip:{trigger:'axis',...TIP,axisPointer:{type:'shadow'},valueFormatter:v=>v+' '+unit},
    xAxis:{type:'value',...AX},
    yAxis:{type:'category',data:labels,...AX,axisLabel:{color:'#c3d2f0',fontSize:11.5}},
    series:[{type:'bar',data:vals,barWidth:'56%',
      itemStyle:{borderRadius:[0,4,4,0],
        color:new echarts.graphic.LinearGradient(0,0,1,0,[{offset:0,color:color[0]},{offset:1,color:color[1]}])},
      label:{show:true,position:'right',color:'#dfe9ff',fontSize:11,formatter:'{c}'}}]
  });
  return ch;
}
const charts=[];
charts.push(bar('cProv',arrProv.map(d=>d[0]),arrProv.map(d=>d[1]),['rgba(79,216,255,.35)','#4fd8ff'],'家'));
charts.push(bar('cProvScreen',arrProvS.map(d=>d[0]),arrProvS.map(d=>d[1]),['rgba(255,215,122,.35)','#ffd77a'],'块'));
charts.push(bar('cCity',arrCity.map(d=>d[0]).reverse(),arrCity.map(d=>d[1]).reverse(),['rgba(255,111,156,.3)','#ff6f9c'],'家'));
charts.push(bar('cMall',arrMall.map(d=>d.name),arrMall.map(d=>d.cnt),['rgba(167,139,255,.35)','#a78bff'],'块'));

/* 日期环形图 */
const dOrder=['12.4','11.28','未标注','待定'];
const dColor={'12.4':'#ff6f9c','11.28':'#ffd77a','未标注':'#5d7bb8','待定':'#4fd8ff'};
const dData=dOrder.filter(k=>byDate[k]).map(k=>({name:k,value:byDate[k],itemStyle:{color:dColor[k]}}));
