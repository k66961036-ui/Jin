/* ---------- 表格 ---------- */
const provs=[...new Set(DATA.map(r=>r.prov).filter(Boolean))].sort();
const selProv=document.getElementById('selProv');
selProv.innerHTML='<option value="">全部省份</option>'+provs.map(p=>`<option value="${p}">${p}</option>`).join('');

let sortKey='cnt';
function dateTag(d){
  const s=d||'未标注';
  if(/12\.4/.test(s)) return `<span class="tag t124">12.4</span>`;
  if(/11\.2[5789]/.test(s)) return `<span class="tag t1128">11.28</span>`;
  if(s==='未标注') return `<span class="tag tnone">未标注</span>`;
  return `<span class="tag tnone">${s}</span>`;
}
function render(){
  const q=document.getElementById('q').value.trim().toLowerCase();
  const p=selProv.value, dp=document.getElementById('selDate').value;
  let list=DATA.filter(r=>{
    if(p && r.prov!==p) return false;
    if(dp){
      const d=r.date||'未标注';
      const key=/12\.4/.test(d)?'12.4':(/11\.2[5789]/.test(d)?'11.28':(d==='未标注'?'未标注':'待定'));
      if(key!==dp) return false;
    }
    if(q){
      const hay=[r.prov,r.city,r.mall,r.addr,r.pos,r.size].join(' ').toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
  if(sortKey==='cnt') list.sort((a,b)=>(Number(b.cnt)||0)-(Number(a.cnt)||0));
  else if(sortKey==='prov') list.sort((a,b)=>(a.prov||'').localeCompare(b.prov||'','zh')||(Number(b.cnt)||0)-(Number(a.cnt)||0));
  else list.sort((a,b)=>(a.date||'zz').localeCompare(b.date||'zz','zh'));

  const sum=list.reduce((s,r)=>s+(Number(r.cnt)||0),0);
  document.getElementById('sumCnt').textContent=sum;
  document.getElementById('cntInfo').innerHTML=`筛选出 <b style="color:#ffd77a">${list.length}</b> 家商场 / ${new Set(list.map(r=>r.prov)).size} 个省份`;
  document.getElementById('tbody').innerHTML=list.map((r,i)=>`
    <tr>
      <td style="color:#68789c">${i+1}</td>
      <td>${r.prov||'-'}</td>
      <td class="city">${r.city||'-'}</td>
      <td class="mall">${r.mall}</td>
      <td>${dateTag(r.date)}</td>
      <td style="color:#b9cbff">${r.time||'<span style="color:#5d6d92">未标注</span>'}</td>
      <td style="color:#b9cbff">${r.freq||'<span style="color:#5d6d92">-</span>'}</td>
      <td class="cntpill">${Number(r.cnt)||0}</td>
      <td>
        <div style="color:#c3d2f0;font-size:11.5px;line-height:1.55">${(r.pos||'-').replace(/\n/g,' ')}</div>
        <div class="addr">${(r.addr||'').trim()||''}${r.size?' &nbsp;·&nbsp; 尺寸 '+r.size.replace(/\n/g,' / '):''}</div>
      </td>
    </tr>`).join('');
}
document.getElementById('q').addEventListener('input',render);
selProv.addEventListener('change',render);
document.getElementById('selDate').addEventListener('change',render);
document.querySelectorAll('#sortChips .chip').forEach(c=>c.addEventListener('click',()=>{
  document.querySelectorAll('#sortChips .chip').forEach(x=>x.classList.remove('on'));
  c.classList.add('on'); sortKey=c.dataset.sort; render();
}));
render();

window.addEventListener('resize',()=>charts.forEach(c=>c.resize()));
</script>
