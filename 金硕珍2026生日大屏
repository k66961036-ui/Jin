.card h3::before{content:'';width:3px;height:13px;border-radius:2px;background:linear-gradient(180deg,var(--rose),var(--cyan))}
.chart{width:100%}

table{width:100%;border-collapse:collapse;font-size:12.5px}
thead th{position:sticky;top:0;background:#111a3a;color:#b9cbff;text-align:left;padding:9px 8px;
